+        settings: const RouteSettings(name: 'pos_profile'),
+        builder: (_) => ProfilePage(onUpdated: (profile) {
+          if (!mounted) return;
+          context.read<AppLockCubit>().applyActiveEmployeeProfile(
+            id: profile.id, name: profile.name, photoUrl: profile.photo,
+          );
+        }),
+      ),
+    );
+  }
